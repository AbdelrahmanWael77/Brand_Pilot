# Copy this file to `.env` (git-ignored) and fill in the values. Never commit `.env`.

# NEVER put a real key in this file: it is tracked by git. Real values go in `.env` only.
#
# AI provider key for the AI Marketing Director and the AI theme suggestions. Set ONE of the two.
# Without a key the app runs: the Director falls back to the built-in rules engine and post
# suggestions come from keyword rules.
# Claude (Anthropic):
ANTHROPIC_API_KEY=
# OpenAI (GPT):
OPENAI_API_KEY=
# OpenRouter (many models behind one key, https://openrouter.ai):
BRANDPILOT_OPENROUTER_API_KEY=
# One OpenRouter model id, or several separated by commas — each becomes a choice in Settings → AI model.
# Empty = openrouter/auto. Example: BRANDPILOT_OPENROUTER_MODEL=anthropic/claude-opus-5.5,google/gemini-3-pro
BRANDPILOT_OPENROUTER_MODEL=

# Optional: which provider to start with when several keys are set (anthropic | openai | openrouter).
# Default: the first key that is set (Anthropic, OpenAI, OpenRouter). Every provider with a key can be
# chosen later in Settings → AI model; that choice is saved and wins over this one.
AI_PROVIDER=

# Optional: model id for the starting provider. Defaults: claude-opus-5-5 (Anthropic), gpt-6-astra (OpenAI).
# Example for OpenAI: AI_MODEL=gpt-6-luna
AI_MODEL=

# Live Meta connection (Facebook Pages + Instagram professional accounts, read-only). Leave empty to keep
# Meta on file import only. Create an app at developers.facebook.com (type "Business"), add the Facebook
# Login product, and register META_REDIRECT_URI as a "Valid OAuth Redirect URI" in its settings.
META_APP_ID=
META_APP_SECRET=
# The full public URL of the callback, e.g. https://brandpilot.example.com/api/integrations/meta/callback
META_REDIRECT_URI=
# 64 hex characters used to encrypt the saved Meta tokens. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes saved connections unreadable (companies then connect again).
TOKEN_KEY=
# Optional: Graph API version (default v27.0).
# META_GRAPH_VERSION=v27.0

# Live Google connection (GA4 + Search Console, read-only). Leave empty to keep them on file import only.
# In Google Cloud Console: create a project, enable "Google Analytics Admin API", "Google Analytics Data API"
# and "Google Search Console API", configure the OAuth consent screen, then create an OAuth client ID of type
# "Web application" with GOOGLE_REDIRECT_URI as an authorised redirect URI. Uses TOKEN_KEY (above) too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The full public URL of the callback, e.g. https://brandpilot.example.com/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# Canva: every user connects their own Canva account; "Generate with Canva" in the Campaign Studio then calls
# Canva's MCP server (https://api.canva.com/connect/v1/mcp) for that user. Leave empty to keep Canva off.
# The app in the Developer Portal must have "Canva MCP" turned on (canva.dev/docs/apps/mcp).
# In the Canva Developer Portal (canva.com/developers): create an integration, enable the scopes listed in
# CANVA_SCOPES below, and add CANVA_REDIRECT_URI as a redirect URL. Uses TOKEN_KEY (above) too.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# The full URL of the callback, e.g. https://brandpilot.example.com/api/integrations/canva/callback
# For local use try http://127.0.0.1:3000/api/integrations/canva/callback and open the app at the same host
# (the sign-in cookie belongs to one host; whether Canva also accepts "localhost" is not confirmed).
CANVA_REDIRECT_URI=
# Optional. Space separated; every scope must be enabled on the integration. Default:
# profile:read design:meta:read design:content:read design:content:write asset:read asset:write brandtemplate:meta:read brandtemplate:content:read brandkit:read
CANVA_SCOPES=
# Optional. Where the sign-in code is exchanged. Default https://api.canva.com/auth/v1/oauth/token (what Canva's MCP
# server publishes); if Canva refuses the exchange, try https://api.canva.com/rest/v1/oauth/token
CANVA_TOKEN_URL=

# AI pictures for campaign posts (tasks 9.12 / 9.13): Cloudflare Workers AI, FLUX.1 [schnell]. Leave empty to keep
# "Generate image with AI" hidden. In the Cloudflare dashboard: Workers AI → "Use REST API" → create a Workers AI API token
# (permissions Workers AI Read + Edit) and copy your Account ID (32 hex characters). Free: 10,000 neurons a day.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Optional. Default @cf/black-forest-labs/flux-1-schnell
AI_IMAGE_MODEL=

# Behind a reverse proxy (nginx, a cloud load balancer) set the number of proxies in front,
# usually 1, so sign-in limits see the visitor's real address. Leave empty when the app is
# reached directly.
TRUST_PROXY=

# Optional: port (default 3000) and database file (default data/brandpilot.db).
# PORT=3000
# BRANDPILOT_DB=data/brandpilot.db
