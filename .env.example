# Copy this file to `.env` (git-ignored) and fill in the values. Never commit `.env`.

# Claude API key for the AI Marketing Director. Without it the app runs, and the
# Director falls back to the built-in rules engine.
ANTHROPIC_API_KEY=

# Optional: Claude model id (default: claude-opus-5-5).
AI_MODEL=

# Behind a reverse proxy (nginx, a cloud load balancer) set the number of proxies in front,
# usually 1, so sign-in limits see the visitor's real address. Leave empty when the app is
# reached directly.
TRUST_PROXY=

# Optional: port (default 3000) and database file (default data/brandpilot.db).
# PORT=3000
# BRANDPILOT_DB=data/brandpilot.db
