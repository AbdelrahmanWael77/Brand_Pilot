# Copy this file to `.env` (git-ignored) and fill in the values. Never commit `.env`.

# Claude API key for the AI Marketing Director. Without it the app runs, and the
# Director falls back to the built-in rules engine.
ANTHROPIC_API_KEY=

# Optional: Claude model id (default: claude-opus-5-5).
AI_MODEL=

# Live Meta connection (Facebook Pages + Instagram professional accounts, read-only). Leave empty to keep
# Meta on file import only. Create an app at developers.facebook.com (type "Business"), add the Facebook
# Login product, and register META_REDIRECT_URI as a "Valid OAuth Redirect URI" in its settings.
META_APP_ID=
META_APP_SECRET=
# The full public URL of the callback, e.g. https://brandpilot.example.com/api/integrations/meta/callback
META_REDIRECT_URI=
# 64 hex characters used to encrypt the saved Meta tokens. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes saved connections unreadable (companies then connect again).
TOKEN_KEY=
# Optional: Graph API version (default v27.0).
# META_GRAPH_VERSION=v27.0

# Behind a reverse proxy (nginx, a cloud load balancer) set the number of proxies in front,
# usually 1, so sign-in limits see the visitor's real address. Leave empty when the app is
# reached directly.
TRUST_PROXY=

# Optional: port (default 3000) and database file (default data/brandpilot.db).
# PORT=3000
# BRANDPILOT_DB=data/brandpilot.db
